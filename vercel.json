{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/preview-dashboard",
      "destination": "/moments/preview-dashboard/index.html"
    },
    {
      "source": "/landing-page",
      "destination": "/moments/landing-page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
